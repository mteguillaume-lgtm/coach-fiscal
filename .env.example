# Backend patrimoine (fonctions Vercel api/bank/*) — variables d'environnement.
#
# DÉPLOIEMENT RECOMMANDÉ : déployer ce dossier api/ dans le MÊME projet Vercel que
# la SPA Kapio. Le backend est alors servi sur la même origine (ex.
# https://mon-kapio.vercel.app/api/bank/…) et la CSP de vercel.json (`connect-src
# 'self'`) autorise l'appel du navigateur sans rien changer.
#
# SI vous hébergez le backend sur une AUTRE origine (autre domaine Vercel), le
# navigateur BLOQUERA l'appel : il faut alors ajouter cette origine à `connect-src`
# dans la directive Content-Security-Policy de votre vercel.json
# (ex. `connect-src 'self' https://mon-backend.vercel.app …`).

GOCARDLESS_SECRET_ID=
GOCARDLESS_SECRET_KEY=
KAPIO_BACKEND_SECRET=      # jeton secret perso (long, aléatoire) — openssl rand -hex 24
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
APP_ORIGIN=http://localhost:5173   # origine de la SPA (pour la redirection retour de consentement)
